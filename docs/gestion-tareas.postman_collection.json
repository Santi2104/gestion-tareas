{
	"info": {
		"_postman_id": "8f39a752-6e21-4d37-975e-9988e0b69822",
		"name": "Gestión de Tareas API",
		"description": "Colección de endpoints para la aplicación de Gestión de Tareas",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "1. Obtener CSRF Cookie",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/sanctum/csrf-cookie",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"sanctum",
								"csrf-cookie"
							]
						},
						"description": "Inicializa la cookie de sesión y token CSRF para peticiones SPA."
					},
					"response": []
				},
				{
					"name": "2. Iniciar Sesión (Login)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-XSRF-TOKEN",
								"value": "{{xsrfToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"login"
							]
						},
						"description": "Autentica al usuario en el sistema usando Fortify."
					},
					"response": []
				},
				{
					"name": "3. Registrar Usuario",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-XSRF-TOKEN",
								"value": "{{xsrfToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Nuevo Usuario\",\n    \"email\": \"usuario@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"register"
							]
						},
						"description": "Registra un nuevo usuario en la base de datos."
					},
					"response": []
				},
				{
					"name": "4. Obtener Usuario Autenticado",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/user",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"user"
							]
						},
						"description": "Devuelve la información del usuario en sesión actual."
					},
					"response": []
				},
				{
					"name": "5. Cerrar Sesión (Logout)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "X-XSRF-TOKEN",
								"value": "{{xsrfToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"logout"
							]
						},
						"description": "Invalida la sesión actual del usuario."
					},
					"response": []
				}
			]
		},
		{
			"name": "Tareas (Tasks)",
			"item": [
				{
					"name": "Listar Tareas (con Filtros opcionales)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/tasks?status=pending&priority_id=1&due_date=2026-12-31",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tasks"
							],
							"query": [
								{
									"key": "status",
									"value": "pending",
									"description": "pending, in_progress, completed",
									"disabled": true
								},
								{
									"key": "priority_id",
									"value": "1",
									"description": "ID de la prioridad",
									"disabled": true
								},
								{
									"key": "due_date",
									"value": "2026-12-31",
									"description": "Fecha de vencimiento (YYYY-MM-DD)",
									"disabled": true
								}
							]
						},
						"description": "Obtiene la lista de tareas con sus relaciones de prioridad y etiquetas."
					},
					"response": []
				},
				{
					"name": "Obtener Tarea por ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/tasks/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tasks",
								"1"
							]
						},
						"description": "Obtiene los detalles de una tarea específica."
					},
					"response": []
				},
				{
					"name": "Crear Tarea",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-XSRF-TOKEN",
								"value": "{{xsrfToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Implementar autenticación de dos factores\",\n    \"description\": \"Configurar soporte para TOTP y códigos de recuperación.\",\n    \"status\": \"pending\",\n    \"due_date\": \"2026-12-31\",\n    \"priority_id\": 3,\n    \"tag_ids\": [1, 2]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tasks",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tasks"
							]
						},
						"description": "Crea una nueva tarea asociando una prioridad y etiquetas."
					},
					"response": []
				},
				{
					"name": "Actualizar Tarea",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-XSRF-TOKEN",
								"value": "{{xsrfToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Implementar autenticación de dos factores (Actualizado)\",\n    \"description\": \"Descripción actualizada con nuevas especificaciones de seguridad.\",\n    \"status\": \"in_progress\",\n    \"due_date\": \"2026-11-30\",\n    \"priority_id\": 2,\n    \"tag_ids\": [1, 3]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tasks/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tasks",
								"1"
							]
						},
						"description": "Actualiza los campos de una tarea existente."
					},
					"response": []
				},
				{
					"name": "Cambiar Estado de Tarea",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-XSRF-TOKEN",
								"value": "{{xsrfToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"completed\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tasks/1/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tasks",
								"1",
								"status"
							]
						},
						"description": "Endpoint rápido para actualizar exclusivamente el estado de la tarea (pending, in_progress, completed)."
					},
					"response": []
				},
				{
					"name": "Eliminar Tarea",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "X-XSRF-TOKEN",
								"value": "{{xsrfToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/tasks/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tasks",
								"1"
							]
						},
						"description": "Elimina permanentemente una tarea de la base de datos."
					},
					"response": []
				}
			]
		},
